# For local CLI and web runs, copy this file to .env and set your Gemini key.
REVIEW_PROVIDER=gemini
REVIEW_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# To use a signed-in Codex CLI, select REVIEW_PROVIDER=codex and REVIEW_MODEL=gpt-6.2-astra.
# Optional reserve on your own server:
# REVIEW_FALLBACK_MODEL=@cf/openai/gpt-oss-120b
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# REVIEW_CHROME=/path/to/chrome
