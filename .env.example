# Local Gemini profile. Copy to .env and set your own Gemini key.
REVIEW_PROVIDER=gemini
REVIEW_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# To match the project website locally, replace the two REVIEW_ settings above:
# REVIEW_PROVIDER=openai
# REVIEW_MODEL=gpt-6.2-sol
# OPENAI_API_KEY=
# Direct Responses API calls are billed to the key owner.
# Optional per-request ceiling for lower-throughput API projects. Range 1024..16384.
# OPENAI_MAX_OUTPUT_TOKENS=4096
#
# To use a signed-in Codex CLI, select REVIEW_PROVIDER=codex and REVIEW_MODEL=gpt-6.2-astra.
# Optional reserve on your own server:
# REVIEW_FALLBACK_MODEL=@cf/openai/gpt-oss-120b
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Optional paid OpenAI Responses API reserve after Gemini quota exhaustion:
# REVIEW_FALLBACK_PROVIDER=openai
# REVIEW_FALLBACK_MODEL=gpt-6.2-sol
# OPENAI_API_KEY=
# REVIEW_CHROME=/path/to/chrome
