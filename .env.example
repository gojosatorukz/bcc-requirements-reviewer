# Default: Codex CLI manages login. REVIEW_MODEL is optional.
# REVIEW_PROVIDER=codex
# REVIEW_MODEL=gpt-6.2-astra
#
# Gemini Developer API: export these environment variables for the server or CLI.
# REVIEW_PROVIDER=gemini
# REVIEW_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=<your server-side key>
# Optional independent reserve for a Gemini quota error. Set all three server-side.
# REVIEW_FALLBACK_MODEL=@cf/openai/gpt-oss-120b
# CLOUDFLARE_ACCOUNT_ID=<your account ID>
# CLOUDFLARE_API_TOKEN=<your account-scoped Workers AI token>
# REVIEW_CHROME=/path/to/chrome
